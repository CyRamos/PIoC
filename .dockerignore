.coverage
.nyc_output
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Documentation build
docs/_build/
.readthedocs.yml

# Logs and databases (keep structure but not content)
*.log
*.sqlite
*.db
cti_database.db
cti_application.log

# Temporary files and uploads (keep structure but not content)
temp/*
uploads/*
exports/*
!temp/.gitkeep
!uploads/.gitkeep
!exports/.gitkeep

# Sample and test data
data/*.csv
data/*.json
!data/sample*.csv

# Development files
*.md
!README.md
Dockerfile*
docker-compose*
.dockerignore

# Runtime files
*.pid
*.sock
